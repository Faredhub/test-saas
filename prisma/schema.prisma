generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// CORE: Multi-Tenant Foundation
// =============================================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  logo      String?
  plan      Plan     @default(FREE)
  status    TenantStatus @default(ACTIVE)

  // Organization details (ORG-B-003)
  pan       String?
  gst       String?
  cin       String?
  address   String?
  city      String?
  state     String?
  country   String?  @default("India")
  pincode   String?
  phone     String?
  email     String?
  website   String?

  // System settings (ORG-A005) — JSON blob for feature toggles, preferences
  settings  Json?  // { modules, currency, dateFormat, fiscalYearStartMonth }

  // Storage & limits
  maxUsers          Int    @default(5)  // Seat limit per plan
  storageUsedBytes BigInt @default(0)
  storageLimitBytes BigInt @default(1073741824) // 1GB default

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users             User[]
  roles             Role[]
  departments       Department[]
  branches          Branch[]
  announcements     Announcement[]
  calendarEvents    CalendarEvent[]
  notes             Note[]
  leads             Lead[]
  contacts          Contact[]
  deals             Deal[]
  quotations        Quotation[]
  invoices          Invoice[]
  activities        Activity[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  dashboardLayouts  DashboardLayout[]
  customFields      CustomFieldDefinition[]
  approvalWorkflows ApprovalWorkflow[]
  contracts         Contract[]
  signatures        Signature[]
  signatureRequests SignatureRequest[]
  documents         Document[]
  visits            Visit[]
  tableReservations TableReservation[]
  orders            Order[]
  queueTokens       QueueToken[]
  loyaltyPoints     LoyaltyPoint[]
  formTemplates     FormTemplate[]
  formSubmissions   FormSubmission[]
  savedReports      SavedReport[]

  // Module 9: Finance
  glAccounts        GLAccount[]     @relation("TenantAccounts")
  journalEntries    JournalEntry[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  salaryStructures  SalaryStructure[]
  payslips          Payslip[]
  vendorBills       VendorBill[]
  financialDocuments FinancialDocument[]

  // Module 8: HRM
  employees         Employee[]
  jobPostings       JobPosting[]
  applicants        Applicant[]
  holidays          Holiday[]
  leaveTypes        LeaveType[]
  leaveRequests     LeaveRequest[]
  attendanceRecords Attendance[]
  vehicles          Vehicle[]
  fuelLogs          FuelLog[]

  // Module 10: Project Management
  projects          Project[]
  tasks             Task[]
  projectMilestones Milestone[]
  timesheets        Timesheet[]
  tickets           Ticket[]
  projectFiles      ProjectFile[]

  // Module 7: Supply Chain
  products          Product[]
  warehouses        Warehouse[]
  warehouseStock    WarehouseStock[]
  stockMovements    StockMovement[]
  manufacturingOrders ManufacturingOrder[]
  assets            Asset[]
  maintenanceRequests MaintenanceRequest[]
  qualityChecks     QualityCheck[]

  // Module 6: Marketing
  campaigns         Campaign[]
  marketingEvents   MarketingEvent[]
  surveys           Survey[]

  // Module 8 gaps: Performance
  performanceReviews PerformanceReview[]
  goals              Goal[]

  // Module 9 gap: Credit/Debit Notes
  creditNotes       CreditNote[]

  // Module 10 gaps: Scheduling, Templates, Portal
  projectTemplates  ProjectTemplate[]
  shifts            Shift[]
  scheduleEntries   ScheduleEntry[]

  // Module 11: Website Builder & CMS
  pages             WebPage[]
  pageTemplates     PageTemplate[]
  blogPosts         BlogPost[]
  blogCategories    BlogCategory[]
  forumTopics       ForumTopic[]
  faqItems          FAQItem[]
  chatWidgets       ChatWidget[]
  chatConversations ChatConversation[]

  // Module 12: Report Generator
  reportTemplates   ReportTemplate[]
  generatedReports  GeneratedReport[]

  // Module 13: Office Collaboration
  officeDocuments   OfficeDocument[]
  spreadsheets      Spreadsheet[]
  presentations     Presentation[]
  emailAccounts     EmailAccount[]
  emailMessages     EmailMessage[]
  chatChannels      ChatChannel[]
  chatMessages      ChatMessage[]
  callSessions      CallSession[]

  // Module 14: Tender & Bid Management (Civil Industry)
  tenders           Tender[]
  bids              Bid[]
  boqItems          BOQItem[]
  emdRecords        EMDRecord[]
  cvRecords         CVRecord[]
  financeLedgers    FinanceLedger[]

  // Mail server (Phase 1 of email integration)
  mailServer        TenantMailServer?

  @@map("tenants")
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

// =============================================================================
// MODULE 1: Authentication & User Management
// =============================================================================

model User {
  id             String    @id @default(cuid())
  tenantId       String
  email          String
  emailVerified  DateTime?
  phone          String?
  phoneVerified  DateTime?
  passwordHash   String?
  name           String?
  firstName      String?
  lastName       String?
  avatar         String?
  status         UserStatus @default(ACTIVE)

  // MFA (AUTH-004)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  mfaBackupCodes String[]

  // Password policy (AUTH-008)
  passwordChangedAt DateTime?
  passwordExpiresAt DateTime?
  failedLoginAttempts Int     @default(0)
  lockedUntil       DateTime?

  // Push notifications (HOME-003)
  pushSubscription Json?

  // Integration tokens (calendar sync, etc.)
  settings Json?

  // Preferences
  theme          Theme     @default(SYSTEM)
  locale         String    @default("en")
  timezone       String    @default("Asia/Kolkata")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?
  lastLoginIp    String?

  // Relations
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleAssignments UserRole[]
  sessions       Session[]
  accounts       Account[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  createdLeads   Lead[]      @relation("LeadCreatedBy")
  assignedLeads  Lead[]      @relation("LeadAssignedTo")
  contacts       Contact[]   @relation("ContactOwner")
  deals          Deal[]      @relation("DealOwner")
  activities     Activity[]
  notes          Note[]
  dashboardLayouts DashboardLayout[]
  quotationsCreated Quotation[] @relation("QuotationCreatedBy")
  invoicesCreated   Invoice[]   @relation("InvoiceCreatedBy")
  contractsCreated  Contract[]  @relation("ContractCreator")
  contractsSigned   Contract[]  @relation("ContractSigner")
  signatures              Signature[]
  signatureRequestsSent   SignatureRequest[] @relation("signatureRequester")
  signatureRequestsReceived SignatureRequest[] @relation("signatureAssignee")
  documents               Document[]
  visits                  Visit[]
  tableReservations       TableReservation[]
  ordersCreated           Order[]
  formsCreated            FormTemplate[]
  savedReports            SavedReport[]

  // Module 8 gaps: Performance
  performanceReviews      PerformanceReview[] @relation("ReviewerReviews")

  // Module 11: CMS
  blogPosts               BlogPost[]
  forumTopics             ForumTopic[]
  assignedConversations   ChatConversation[] @relation("AssignedConversations")

  // Module 13: Office
  officeDocuments         OfficeDocument[] @relation("DocCreator")
  spreadsheets            Spreadsheet[]    @relation("SheetCreator")
  presentations           Presentation[]   @relation("PresentationCreator")
  emailAccounts           EmailAccount[]
  chatChannelsCreated     ChatChannel[]    @relation("ChannelCreator")
  chatMessagesSent        ChatMessage[]    @relation("MessageSender")
  callerSessions          CallSession[]    @relation("CallerSessions")
  calleeSessions          CallSession[]    @relation("CalleeSessions")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  deviceType   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       TokenType @default(EMAIL_VERIFICATION)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
  MFA_SETUP
}

// =============================================================================
// RBAC: Role-Based Access Control (AUTH-007)
// =============================================================================

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false) // System roles can't be deleted
  isDefault   Boolean  @default(false) // Auto-assigned to new users

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String   // e.g., "sales", "organization", "dashboard"
  action      String   // e.g., "create", "read", "update", "delete", "export"
  resource    String   // e.g., "leads", "invoices", "departments"
  description String?

  roles       RolePermission[]

  @@unique([module, action, resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// MODULE 4: Organization Management
// =============================================================================

model Department {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  parentId  String? // For nested hierarchy (ORG-B-001)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model Branch {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  city      String?
  state     String?
  country   String? @default("India")
  pincode   String?
  phone     String?
  email     String?
  isHeadOffice Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

// Notice Board (ORG-C)
model Announcement {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String
  priority  AnnouncementPriority @default(NORMAL)
  audience  AnnouncementAudience @default(ALL)
  isPinned  Boolean  @default(false)
  publishAt DateTime @default(now())
  expiresAt DateTime?
  authorId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("announcements")
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementAudience {
  ALL
  DEPARTMENT
  TEAM
  BRANCH
}

// Calendar & Scheduling (ORG-D)
model CalendarEvent {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  isAllDay    Boolean  @default(false)
  isRecurring Boolean  @default(false)
  recurrenceRule String? // RRULE format
  type        EventType @default(MEETING)
  reminderMinutes Int?     // null = no reminder, 5/15/30/60 = minutes before event
  reminderSent    Boolean  @default(false) // Prevents duplicate reminder notifications
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@map("calendar_events")
}

enum EventType {
  MEETING
  APPOINTMENT
  REMINDER
  TASK_DEADLINE
  OTHER
}

// Notes & To-Do (ORG-E)
model Note {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  content   String?
  type      NoteType @default(NOTE)
  isShared  Boolean  @default(false)
  isPinned  Boolean  @default(false)
  dueDate   DateTime?
  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("notes")
}

enum NoteType {
  NOTE
  TODO
}

// =============================================================================
// MODULE 5: Sales & CRM
// =============================================================================

// Sub-Module 5A: CRM - Lead & Opportunity Management
model Lead {
  id          String     @id @default(cuid())
  tenantId    String
  source      LeadSource @default(MANUAL)
  status      LeadStatus @default(NEW)

  // Contact info
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  company     String?
  jobTitle    String?

  // Pipeline (SALES-A-002)
  pipelineStage PipelineStage @default(NEW)
  score         Int           @default(0) // SALES-A-003
  estimatedValue Decimal?     @db.Decimal(15, 2)
  currency       String       @default("INR")

  // Assignment
  assignedToId String?
  createdById  String

  // Metadata
  notes       String?
  tags        String[]
  lostReason  String?
  wonDate     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo  User?    @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdBy   User     @relation("LeadCreatedBy", fields: [createdById], references: [id])
  activities  Activity[]
  deals       Deal[]
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  visits      Visit[]

  @@index([tenantId])
  @@index([tenantId, pipelineStage])
  @@index([tenantId, assignedToId])
  @@map("leads")
}

enum LeadSource {
  MANUAL
  WEB_FORM
  EMAIL
  PHONE
  SOCIAL_MEDIA
  REFERRAL
  ADVERTISEMENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum PipelineStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// Contact Management (SALES-A-004)
model Contact {
  id          String @id @default(cuid())
  tenantId    String
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  company     String?
  jobTitle    String?
  address     String?
  city        String?
  state       String?
  country     String? @default("India")
  pincode     String?
  latitude    Float?
  longitude   Float?
  notes       String?
  tags        String[]
  ownerId     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User     @relation("ContactOwner", fields: [ownerId], references: [id])
  leads       Lead[]
  deals       Deal[]
  activities  Activity[]
  quotations  Quotation[]
  invoices    Invoice[]
  contracts      Contract[]
  visits         Visit[]
  loyaltyPoints  LoyaltyPoint[]
  creditNotes    CreditNote[]   @relation("ContactCreditNotes")

  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@map("contacts")
}

// Deal/Opportunity Management (SALES-A-006)
model Deal {
  id             String    @id @default(cuid())
  tenantId       String
  title          String
  value          Decimal?  @db.Decimal(15, 2)
  currency       String    @default("INR")
  probability    Int       @default(0) // 0-100%
  stage          DealStage @default(PROSPECTING)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  lostReason     String?
  notes          String?

  ownerId        String
  contactId      String?
  leadId         String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User     @relation("DealOwner", fields: [ownerId], references: [id])
  contact        Contact? @relation(fields: [contactId], references: [id])
  lead           Lead?    @relation(fields: [leadId], references: [id])
  activities     Activity[]
  quotations     Quotation[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, ownerId])
  @@map("deals")
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// Activity Tracking (SALES-A-005)
model Activity {
  id          String       @id @default(cuid())
  tenantId    String
  type        ActivityType
  subject     String
  description String?
  outcome     String?
  scheduledAt DateTime?
  completedAt DateTime?
  duration    Int?         // in minutes
  userId      String

  // Polymorphic relations
  leadId      String?
  contactId   String?
  dealId      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  lead        Lead?    @relation(fields: [leadId], references: [id])
  contact     Contact? @relation(fields: [contactId], references: [id])
  deal        Deal?    @relation(fields: [dealId], references: [id])

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@map("activities")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  VISIT
}

// Sub-Module 5B: Quotation & Invoicing
model Quotation {
  id           String          @id @default(cuid())
  tenantId     String
  quotationNo  String
  contactId    String?
  dealId       String?
  createdById  String
  status       QuotationStatus @default(DRAFT)

  // Amounts
  subtotal     Decimal  @db.Decimal(15, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(15, 2)
  discount     Decimal  @default(0) @db.Decimal(15, 2)
  total        Decimal  @db.Decimal(15, 2)
  currency     String   @default("INR")

  // GST fields
  cgst         Decimal  @default(0) @db.Decimal(15, 2)
  sgst         Decimal  @default(0) @db.Decimal(15, 2)
  igst         Decimal  @default(0) @db.Decimal(15, 2)

  validUntil   DateTime?
  notes        String?
  terms        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id])
  deal         Deal?    @relation(fields: [dealId], references: [id])
  createdBy    User     @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  items        QuotationItem[]
  invoice      Invoice?

  @@unique([tenantId, quotationNo])
  @@index([tenantId])
  @@map("quotations")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(15, 2)
  sortOrder   Int     @default(0)

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model Invoice {
  id           String        @id @default(cuid())
  tenantId     String
  invoiceNo    String
  contactId    String?
  quotationId  String?       @unique
  createdById  String
  status       InvoiceStatus @default(DRAFT)

  // Amounts
  subtotal     Decimal  @db.Decimal(15, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(15, 2)
  discount     Decimal  @default(0) @db.Decimal(15, 2)
  total        Decimal  @db.Decimal(15, 2)
  amountPaid   Decimal  @default(0) @db.Decimal(15, 2)
  currency     String   @default("INR")

  // GST fields (GST-compliant: SALES-B-002)
  cgst         Decimal  @default(0) @db.Decimal(15, 2)
  sgst         Decimal  @default(0) @db.Decimal(15, 2)
  igst         Decimal  @default(0) @db.Decimal(15, 2)

  dueDate      DateTime?
  paidDate     DateTime?
  paymentTerms String?
  notes        String?

  // Recurring (SALES-D-001)
  isRecurring     Boolean  @default(false)
  recurrenceRule  String?
  nextRecurrence  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id])
  quotation    Quotation? @relation(fields: [quotationId], references: [id])
  createdBy    User     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  creditNotes  CreditNote[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(15, 2)
  sortOrder   Int     @default(0)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(15, 2)
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  paidAt      DateTime      @default(now())

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  RAZORPAY
  STRIPE
  OTHER
}

// =============================================================================
// MODULE 3: Dashboard (Layout persistence)
// =============================================================================

model DashboardLayout {
  id        String @id @default(cuid())
  tenantId  String
  userId    String
  name      String @default("Default")
  widgets   Json   // Array of widget configs: { type, position, size, config }
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("dashboard_layouts")
}

// =============================================================================
// CORE: Cross-Cutting Features
// =============================================================================

// Audit Log (AUTH-010, CORE-006)
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String   // e.g., "user.login", "lead.create", "invoice.update"
  entity    String?  // e.g., "Lead", "Invoice"
  entityId  String?
  metadata  Json?    // Additional context
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Notifications (CORE-007)
model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?

  createdAt DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
  LEAD_ASSIGNED
  DEAL_UPDATE
  INVOICE_DUE
  ANNOUNCEMENT
  MEETING_REMINDER
  REMINDER
  SIGNATURE_REQUEST
}

// Custom Fields (CORE-010)
model CustomFieldDefinition {
  id        String    @id @default(cuid())
  tenantId  String
  module    String    // e.g., "leads", "contacts", "deals"
  fieldName String
  fieldType FieldType
  options   Json?     // For SELECT/MULTI_SELECT types
  isRequired Boolean  @default(false)
  sortOrder  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, fieldName])
  @@index([tenantId, module])
  @@map("custom_field_definitions")
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
  EMAIL
  PHONE
}

// Contracts Management (ORG-G-001-004)
model Contract {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  contractNo    String
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id])
  type          String    @default("SERVICE") // SERVICE, EMPLOYMENT, NDA, VENDOR, CUSTOM
  status        String    @default("DRAFT") // DRAFT, SENT, SIGNED, ACTIVE, EXPIRED, CANCELLED
  value         Decimal?  @db.Decimal(15, 2)
  startDate     DateTime?
  endDate       DateTime?
  renewalDate   DateTime?
  autoRenew     Boolean   @default(false)
  terms         String?   @db.Text
  notes         String?   @db.Text
  signedAt      DateTime?
  signedById    String?
  signedBy      User?     @relation("ContractSigner", fields: [signedById], references: [id])
  createdById   String
  createdBy     User      @relation("ContractCreator", fields: [createdById], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pdfName       String?
  pdfSize       Int?
  pdfContent    String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, contractNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("contracts")
}

// Digital Signatures (ORG-F-001-003)
model Signature {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  dataUrl   String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId])
  @@map("signatures")
}

// Library / Knowledge Base (ORG-I-001-004)
model Document {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  category     String   @default("GENERAL") // GENERAL, SOP, POLICY, TEMPLATE, TRAINING, OTHER
  tags         String[] @default([])
  fileName     String   @default("")
  fileSize     Int      @default(0)
  mimeType     String   @default("text/plain")
  filePath     String?  // For future file storage
  content      String?  @db.Text  // For text-based documents, searchable
  version      Int      @default(1)
  isPublic     Boolean  @default(true)  // visible to all org members
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@map("documents")
}

// Approval Workflows (ORG-B-004)
model ApprovalWorkflow {
  id          String @id @default(cuid())
  tenantId    String
  name        String
  module      String // e.g., "quotations", "invoices", "expenses"
  steps       Json   // Array of { level, approverRoleId, approverUserId }
  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("approval_workflows")
}

// Signature Requests (ORG-F-002)
model SignatureRequest {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  description   String?   @db.Text
  documentRef   String?
  requestedById String
  requestedBy   User      @relation("signatureRequester", fields: [requestedById], references: [id])
  assignedToId  String
  assignedTo    User      @relation("signatureAssignee", fields: [assignedToId], references: [id])
  status        String    @default("PENDING") // PENDING, SIGNED, DECLINED, EXPIRED
  signatureId   String?
  signedAt      DateTime?
  declinedAt    DateTime?
  declineReason String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@map("signature_requests")
}

// Visit Logging (SALES-E-003)
model Visit {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  purpose     String
  outcome     String?   @db.Text
  notes       String?   @db.Text
  checkInAt   DateTime  @default(now())
  checkOutAt  DateTime?
  location    String?
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("visits")
}

// Order Management (SALES-C003)
model Order {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNo       String
  tableNumber   String?
  customerName  String?
  status        String      @default("PENDING") // PENDING, PREPARING, READY, SERVED, COMPLETED, CANCELLED
  items         OrderItem[]
  subtotal      Decimal     @default(0) @db.Decimal(15, 2)
  taxAmount     Decimal     @default(0) @db.Decimal(15, 2)
  total         Decimal     @default(0) @db.Decimal(15, 2)
  notes         String?
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(15, 2)
  notes       String?
  sortOrder   Int     @default(0)

  @@map("order_items")
}

// Table Reservation (SALES-C004)
model TableReservation {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tableNumber   String
  customerName  String
  customerPhone String?
  partySize     Int       @default(1)
  reservedAt    DateTime
  duration      Int       @default(60) // minutes
  status        String    @default("RESERVED") // RESERVED, SEATED, COMPLETED, CANCELLED, NO_SHOW
  notes         String?
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@map("table_reservations")
}

// Token/Queue Management (SALES-C005)
model QueueToken {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenNumber  Int
  customerName String?
  phone        String?
  purpose      String?
  status       String    @default("WAITING") // WAITING, SERVING, COMPLETED, SKIPPED
  calledAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
  @@map("queue_tokens")
}

// Loyalty Points (SALES-C005)
model LoyaltyPoint {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id])
  points      Int      @default(0)
  type        String   // EARNED, REDEEMED, EXPIRED, ADJUSTED
  description String?
  invoiceId   String?
  createdAt   DateTime @default(now())

  @@index([tenantId, contactId])
  @@map("loyalty_points")
}

// =============================================================================
// Form Builder (ORG-H-001-004)
// =============================================================================

model FormTemplate {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fields      Json             @default("[]") // Array of field definitions
  isPublished Boolean          @default(false)
  shareUrl    String?          @unique
  submissions FormSubmission[]
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId])
  @@map("form_templates")
}

model FormSubmission {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formId     String
  form       FormTemplate @relation(fields: [formId], references: [id], onDelete: Cascade)
  data       Json         @default("{}") // Key-value pairs of field responses
  submittedBy String?
  submittedAt DateTime    @default(now())

  @@index([tenantId, formId])
  @@map("form_submissions")
}

// Saved Reports (ORG-J001-005)
model SavedReport {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  config      Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("saved_reports")
}

// =============================================================================
// MODULE 9: Finance & Accounting
// =============================================================================

// Chart of Accounts (FIN-A-001)
model GLAccount {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation("TenantAccounts", fields: [tenantId], references: [id], onDelete: Cascade)
  code        String      // e.g. "1000", "2100"
  name        String
  type        AccountType
  parentId    String?
  parent      GLAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    GLAccount[] @relation("AccountHierarchy")
  description String?
  currency    String      @default("INR")
  isActive    Boolean     @default(true)
  balance     Decimal     @default(0) @db.Decimal(15, 2)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  journalLines JournalLine[]
  expenseCategory ExpenseCategory[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("gl_accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// Journal Entries (FIN-A-002)
model JournalEntry {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryNo     String
  date        DateTime
  description String?
  reference   String?   // Invoice #, receipt #, etc.
  status      JournalStatus @default(DRAFT)
  isAutomatic Boolean   @default(false)
  createdById String
  approvedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines       JournalLine[]

  @@unique([tenantId, entryNo])
  @@index([tenantId])
  @@index([tenantId, date])
  @@map("journal_entries")
}

enum JournalStatus {
  DRAFT
  POSTED
  VOIDED
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        GLAccount @relation(fields: [accountId], references: [id])
  debit          Decimal  @default(0) @db.Decimal(15, 2)
  credit         Decimal  @default(0) @db.Decimal(15, 2)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

// Expense Management (FIN-C-001-004)
model ExpenseCategory {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  accountId String?
  account   GLAccount? @relation(fields: [accountId], references: [id])
  monthlyLimit Decimal? @db.Decimal(15, 2)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses  Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseNo   String
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description String
  amount      Decimal       @db.Decimal(15, 2)
  currency    String        @default("INR")
  date        DateTime
  receiptUrl  String?
  status      ExpenseStatus @default(PENDING)
  submittedById String
  approvedById  String?
  paidAt      DateTime?
  notes       String?
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, expenseNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("expenses")
}

enum ExpenseStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

// Payroll (FIN-D-001-006)
model SalaryStructure {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  basic     Decimal @db.Decimal(10, 2)  // percentage of CTC
  hra       Decimal @default(0) @db.Decimal(10, 2)
  da        Decimal @default(0) @db.Decimal(10, 2)
  specialAllowance Decimal @default(0) @db.Decimal(10, 2)
  pfEmployee   Decimal @default(12) @db.Decimal(5, 2)  // % of basic
  pfEmployer   Decimal @default(12) @db.Decimal(5, 2)
  esiEmployee  Decimal @default(0.75) @db.Decimal(5, 2)
  esiEmployer  Decimal @default(3.25) @db.Decimal(5, 2)
  tds          Decimal @default(0) @db.Decimal(5, 2)
  professionalTax Decimal @default(0) @db.Decimal(10, 2)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  payslips  Payslip[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("salary_structures")
}

model Payslip {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  structureId String?
  structure   SalaryStructure? @relation(fields: [structureId], references: [id])
  month       Int     // 1-12
  year        Int
  workingDays Int     @default(0)
  presentDays Int     @default(0)
  leaveDays   Int     @default(0)

  // Earnings
  basicPay    Decimal @db.Decimal(15, 2)
  hra         Decimal @default(0) @db.Decimal(15, 2)
  da          Decimal @default(0) @db.Decimal(15, 2)
  specialAllowance Decimal @default(0) @db.Decimal(15, 2)
  overtime    Decimal @default(0) @db.Decimal(15, 2)
  bonus       Decimal @default(0) @db.Decimal(15, 2)
  grossEarnings Decimal @db.Decimal(15, 2)

  // Deductions
  pfEmployee  Decimal @default(0) @db.Decimal(15, 2)
  pfEmployer  Decimal @default(0) @db.Decimal(15, 2)
  esiEmployee Decimal @default(0) @db.Decimal(15, 2)
  esiEmployer Decimal @default(0) @db.Decimal(15, 2)
  tds         Decimal @default(0) @db.Decimal(15, 2)
  professionalTax Decimal @default(0) @db.Decimal(15, 2)
  otherDeductions Decimal @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal @db.Decimal(15, 2)

  netPay      Decimal @db.Decimal(15, 2)
  status      PayslipStatus @default(DRAFT)
  paidAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, employeeId, month, year])
  @@index([tenantId])
  @@index([tenantId, month, year])
  @@map("payslips")
}

enum PayslipStatus {
  DRAFT
  GENERATED
  APPROVED
  PAID
}

// Vendor Bill Management (FIN-E-001-003)
model VendorBill {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billNo      String
  vendorName  String
  vendorGst   String?
  description String?
  amount      Decimal   @db.Decimal(15, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(15, 2)
  total       Decimal   @db.Decimal(15, 2)
  currency    String    @default("INR")
  dueDate     DateTime?
  status      BillStatus @default(PENDING)
  paidAt      DateTime?
  paidAmount  Decimal   @default(0) @db.Decimal(15, 2)
  notes       String?
  approvedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, billNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("vendor_bills")
}

enum BillStatus {
  PENDING
  APPROVED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// Financial Documents (FIN-F-001-003)
model FinancialDocument {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  type        String  // INVOICE, RECEIPT, BILL, TAX_RETURN, BANK_STATEMENT, OTHER
  category    String? // RECEIVABLE, PAYABLE, TAX, PAYROLL, OTHER
  fileName    String
  fileSize    Int     @default(0)
  mimeType    String  @default("application/pdf")
  reference   String? // Link to invoice/bill/etc
  uploadedById String
  tags        String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("financial_documents")
}

// =============================================================================
// MODULE 8: Human Resource Management
// =============================================================================

// Employee Management (HRM-A-001-004)
model Employee {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?  @unique
  employeeId    String   // Company employee ID e.g. EMP-001
  firstName     String
  middleName    String?
  lastName      String?
  email         String
  phone         String?
  dateOfBirth   DateTime?
  gender        String?  // MALE, FEMALE, OTHER
  maritalStatus String?  // SINGLE, MARRIED, OTHER
  bloodGroup    String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  country       String?  @default("India")

  // Employment details
  departmentId  String?
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  designation   String?
  reportingToId String?
  reportingTo   Employee? @relation("EmployeeReporting", fields: [reportingToId], references: [id])
  reports       Employee[] @relation("EmployeeReporting")
  dateOfJoining DateTime
  dateOfLeaving DateTime?
  employmentType String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  status        EmployeeStatus @default(ACTIVE)

  // Compensation
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id])
  ctc               Decimal?  @db.Decimal(15, 2)
  bankName          String?
  bankAccountNo     String?
  ifscCode          String?
  panNumber         String?
  aadharNumber      String?
  pfNumber          String?
  esiNumber         String?
  uanNumber         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  leaveRequests    LeaveRequest[]
  attendance       Attendance[]
  payslips         Payslip[]
  timesheets       Timesheet[]
  vehicles         Vehicle[]
  performanceReviews PerformanceReview[]
  goals            Goal[]
  scheduleEntries  ScheduleEntry[]

  @@unique([tenantId, employeeId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, branchId])
  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  ON_NOTICE
  RESIGNED
  TERMINATED
  ON_LEAVE
}

// Recruitment (HRM-B-001-004)
model JobPosting {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  department  String?
  location    String?
  type        String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN
  experience  String?  // e.g. "2-5 years"
  salary      String?  // e.g. "5-8 LPA"
  description String   @db.Text
  requirements String? @db.Text
  status      JobStatus @default(DRAFT)
  openings    Int      @default(1)
  closingDate DateTime?
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applicants  Applicant[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("job_postings")
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

model Applicant {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobId       String
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  resumeUrl   String?
  coverLetter String?  @db.Text
  stage       ApplicantStage @default(APPLIED)
  rating      Int?     // 1-5
  notes       String?  @db.Text
  interviewDate DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, jobId])
  @@map("applicants")
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
}

// Holidays & Leave (HRM-C-001-005)
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime
  type      String   @default("PUBLIC") // PUBLIC, COMPANY, OPTIONAL
  isOptional Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([tenantId, name, date])
  @@index([tenantId])
  @@map("holidays")
}

model LeaveType {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String  // Casual, Sick, Earned, LOP
  code          String  // CL, SL, EL, LOP
  annualQuota   Int     @default(0)
  carryForward  Boolean @default(false)
  maxCarry      Int     @default(0)
  isPaid        Boolean @default(true)
  isActive      Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leaveRequests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("leave_types")
}

model LeaveRequest {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  days        Decimal  @db.Decimal(4, 1) // supports half days
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedById String?
  approvedAt  DateTime?
  rejectionReason String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Attendance (HRM-D-001-005)
model Attendance {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  totalHours  Decimal?  @db.Decimal(5, 2)
  overtime    Decimal?  @db.Decimal(5, 2)
  status      AttendanceStatus @default(PRESENT)
  location    String?
  notes       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

// Fleet Management (HRM-F-001-004)
model Vehicle {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrationNo String
  make          String?
  model         String?
  year          Int?
  type          String   @default("CAR") // CAR, BIKE, TRUCK, VAN, OTHER
  fuelType      String?  // PETROL, DIESEL, ELECTRIC, CNG
  assignedToId  String?
  assignedTo    Employee? @relation(fields: [assignedToId], references: [id])
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id])
  status        String   @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  insuranceExpiry DateTime?
  fitnessExpiry  DateTime?
  lastServiceDate DateTime?
  odometerKm    Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fuelLogs      FuelLog[]

  @@unique([tenantId, registrationNo])
  @@index([tenantId])
  @@map("vehicles")
}

model FuelLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  litres      Decimal  @db.Decimal(8, 2)
  costPerLitre Decimal @db.Decimal(8, 2)
  totalCost   Decimal  @db.Decimal(10, 2)
  odometerKm  Int?
  fuelStation String?
  notes       String?

  createdAt   DateTime @default(now())

  @@index([tenantId, vehicleId])
  @@map("fuel_logs")
}

// =============================================================================
// MODULE 10: Task/Project Management
// =============================================================================

// Project Management (PM-A-001-008)
model Project {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?  @db.Text
  status      ProjectStatus @default(PLANNING)
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal? @db.Decimal(15, 2)
  spent       Decimal  @default(0) @db.Decimal(15, 2)
  progress    Int      @default(0) // 0-100
  managerId   String?
  clientName  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
  milestones  Milestone[]
  timesheets  Timesheet[]
  tickets     Ticket[]
  projectFiles ProjectFile[]
  vehicles    Vehicle[]
  expenses    Expense[]
  contracts   Contract[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Task {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  status      TaskStatus @default(TODO)
  priority    String   @default("MEDIUM")
  assigneeId  String?
  dueDate     DateTime?
  estimatedHours Decimal? @db.Decimal(8, 2)
  actualHours Decimal  @default(0) @db.Decimal(8, 2)
  sortOrder   Int      @default(0)
  parentId    String?
  parent      Task?    @relation("TaskHierarchy", fields: [parentId], references: [id])
  subtasks    Task[]   @relation("TaskHierarchy")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, projectId])
  @@index([tenantId, assigneeId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

model Milestone {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, projectId])
  @@map("milestones")
}

// Timesheet (PM-B-001-004)
model Timesheet {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  date        DateTime
  hours       Decimal  @db.Decimal(5, 2)
  description String?
  isBillable  Boolean  @default(true)
  status      TimesheetStatus @default(PENDING)
  approvedById String?
  approvedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, projectId])
  @@map("timesheets")
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

// Helpdesk / Ticketing (PM-D-001-006)
model Ticket {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNo    String
  subject     String
  description String?  @db.Text
  status      TicketStatus @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  reportedById String
  assignedToId String?
  slaDeadline DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments    TicketComment[]

  @@unique([tenantId, ticketNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@map("tickets")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  content   String   @db.Text
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@map("ticket_comments")
}

// Project File Management (PM-F-001-004)
model ProjectFile {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  fileName    String
  fileSize    Int     @default(0)
  mimeType    String  @default("application/octet-stream")
  version     Int     @default(1)
  tags        String[] @default([])
  uploadedById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, projectId])
  @@map("project_files")
}

// =============================================================================
// MODULE 7: Supply Chain Management
// =============================================================================

// Inventory (SCM-A-001-006)
model Product {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  description String?
  category    String?
  unit        String  @default("PCS") // PCS, KG, LTR, MTR, BOX, etc.
  hsnCode     String? // HSN/SAC code for GST
  costPrice   Decimal @default(0) @db.Decimal(15, 2)
  sellingPrice Decimal @default(0) @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  barcode     String?
  minStock    Int     @default(0) // Low stock threshold
  maxStock    Int?
  isActive    Boolean @default(true)
  imageUrl    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockMovements StockMovement[]
  warehouseStock WarehouseStock[]
  bomItems       BOMItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, category])
  @@map("products")
}

// Multi-Location Inventory (SCM-A-002)
model Warehouse {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?
  city      String?
  state     String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock     WarehouseStock[]
  movements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model WarehouseStock {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  reservedQty Int       @default(0)

  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([tenantId])
  @@map("warehouse_stock")
}

model StockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  type        StockMovementType
  quantity    Int
  reference   String?  // PO number, SO number, etc.
  notes       String?
  createdById String
  date        DateTime @default(now())

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, productId])
  @@map("stock_movements")
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

// Manufacturing (SCM-B-001-004)
model ManufacturingOrder {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNo     String
  productName String
  quantity    Int
  status      MfgStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  completedQty Int     @default(0)
  notes       String?
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bomItems    BOMItem[]

  @@unique([tenantId, orderNo])
  @@index([tenantId])
  @@map("manufacturing_orders")
}

enum MfgStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

model BOMItem {
  id          String  @id @default(cuid())
  orderId     String
  order       ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  itemName    String
  quantity    Decimal @db.Decimal(10, 2)
  unit        String  @default("PCS")
  notes       String?

  @@index([orderId])
  @@map("bom_items")
}

// Asset/Equipment (SCM-D-001-004)
model Asset {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetTag      String
  name          String
  category      String?  // MACHINERY, VEHICLE, EQUIPMENT, IT, FURNITURE
  location      String?
  status        String   @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED, DISPOSED
  purchaseDate  DateTime?
  purchaseCost  Decimal? @db.Decimal(15, 2)
  currentValue  Decimal? @db.Decimal(15, 2)
  warrantyExpiry DateTime?
  assignedTo    String?
  serialNumber  String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  maintenanceRequests MaintenanceRequest[]

  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@map("assets")
}

model MaintenanceRequest {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id])
  title       String
  description String?  @db.Text
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  type        String   @default("CORRECTIVE") // CORRECTIVE, PREVENTIVE
  scheduledDate DateTime?
  completedDate DateTime?
  cost        Decimal? @db.Decimal(10, 2)
  assignedTo  String?
  reportedById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@map("maintenance_requests")
}

// Quality Control (SCM-E-001-003)
model QualityCheck {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checkNo     String
  type        String   @default("INCOMING") // INCOMING, IN_PROCESS, FINAL
  reference   String?  // PO/MO reference
  productName String?
  inspector   String?
  status      String   @default("PENDING") // PENDING, PASSED, FAILED, ON_HOLD
  checkedAt   DateTime?
  notes       String?  @db.Text
  defects     Json?    // Array of { description, severity, action }
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, checkNo])
  @@index([tenantId])
  @@map("quality_checks")
}

// =============================================================================
// MODULE 6: Marketing Automation
// =============================================================================

// Email/SMS Campaigns (MKTG-A-001-008)
model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        CampaignType
  channel     CampaignChannel @default(EMAIL)
  subject     String?
  content     String?  @db.Text
  status      CampaignStatus @default(DRAFT)
  segmentTags String[] @default([])
  scheduledAt DateTime?
  sentAt      DateTime?
  createdById String

  // Tracking stats
  totalSent     Int @default(0)
  totalOpened   Int @default(0)
  totalClicked  Int @default(0)
  totalBounced  Int @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("campaigns")
}

enum CampaignType {
  REGULAR
  AUTOMATED
  AB_TEST
}

enum CampaignChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

// Events (MKTG-C-001-003)
model MarketingEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  type        String   @default("CONFERENCE") // CONFERENCE, WEBINAR, WORKSHOP, MEETUP, OTHER
  venue       String?
  isOnline    Boolean  @default(false)
  meetingUrl  String?
  startDate   DateTime
  endDate     DateTime?
  capacity    Int?
  ticketPrice Decimal? @db.Decimal(10, 2)
  currency    String   @default("INR")
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, ONGOING, COMPLETED, CANCELLED
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees   EventAttendee[]

  @@index([tenantId])
  @@map("marketing_events")
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  event     MarketingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  status    String   @default("REGISTERED") // REGISTERED, CONFIRMED, CHECKED_IN, CANCELLED
  ticketNo  String?
  paidAmount Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("event_attendees")
}

// Surveys (MKTG-D-001-003)
model Survey {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  questions   Json     @default("[]") // Array of { id, type, text, options?, required? }
  isPublished Boolean  @default(false)
  shareUrl    String?  @unique
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  responses   SurveyResponse[]

  @@index([tenantId])
  @@map("surveys")
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers   Json     @default("{}") // { questionId: answer }
  respondentEmail String?
  respondentName  String?

  createdAt DateTime @default(now())

  @@index([surveyId])
  @@map("survey_responses")
}

// =============================================================================
// MODULE 8 GAPS: Performance Reviews & Goals (HRM-E-001/002)
// =============================================================================

model PerformanceReview {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  reviewerId   String
  reviewer     User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  period       String   // e.g. "Q1 2026", "2025-2026"
  type         ReviewType @default(ANNUAL)
  status       ReviewStatus @default(DRAFT)
  overallRating Int?    // 1-5
  strengths    String?  @db.Text
  improvements String?  @db.Text
  comments     String?  @db.Text
  selfRating   Int?     // 1-5 employee self-assessment
  selfComments String?  @db.Text
  criteria     Json     @default("[]") // [{ name, weight, rating, comment }]
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@map("performance_reviews")
}

enum ReviewType {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  PROBATION
  PROJECT_BASED
}

enum ReviewStatus {
  DRAFT
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
  ACKNOWLEDGED
}

model Goal {
  id           String   @id @default(cuid())
  tenantId     String
