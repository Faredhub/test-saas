  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([industry, subCategory])
  @@map("industry_templates")
}

// Finance Ledger (Accounts Overhaul)
model FinanceLedger {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slNo          Int
  costType      String   // Office or Site
  itemName      String   // Item - Project/Employee/Vendor - Name
  invoiceNumber String
  amount        Decimal  @db.Decimal(15, 2)
  deduction     Decimal  @default(0) @db.Decimal(15, 2)
  date          String   // Date as "YYYY-MM-DD"
  status        String   // Received or Pending
  paymentMode   String   // Bank or Cash
  email         String?
  contact       String?
  fileName      String?
  fileDataUrl   String?  @db.Text // Base64 data for attachment preview
  remark        String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, slNo])
  @@index([tenantId])
  @@map("finance_ledgers")
}

// ============================================================================
// Email integration — Phase 1: per-tenant mail server config
// ============================================================================
// Super Admin defines one mail server per tenant (Mail-in-a-Box, generic
// IMAP/SMTP, etc.). Individual users will later attach their personal
// mailbox credentials to this server via EmailAccount.config.
model TenantMailServer {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String   // e.g. "Mail-in-a-Box (subhadraconsultant.com)"

  imapHost     String
  imapPort     Int      @default(993)
  imapSecure   Boolean  @default(true)   // true=implicit TLS, false=STARTTLS

  smtpHost     String
  smtpPort     Int      @default(587)
  smtpSecure   Boolean  @default(false)  // false=STARTTLS on 587, true=SMTPS on 465

  fromDomain   String?  // optional default sender domain (e.g. subhadraconsultant.com)

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tenant_mail_servers")
}
