// MODULE 14: Tender & Bid Management (Civil Industry)
// =============================================================================

model Tender {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referenceNo   String                  // Tender reference number
  title         String
  description   String?  @db.Text
  source        TenderSource @default(MANUAL)
  sourceUrl     String?                 // URL from procurement portal
  issuingAuth   String?                 // Issuing authority name
  category      String?                 // Civil, MEP, Architect, etc.
  estimatedValue Decimal? @db.Decimal(15, 2)
  emdAmount     Decimal? @db.Decimal(15, 2)
  emdDeadline   DateTime?
  submissionDeadline DateTime?
  openingDate   DateTime?
  status        TenderStatus @default(IDENTIFIED)

  // Pre-qualification
  preQualStatus PreQualStatus @default(NOT_CHECKED)
  preQualNotes  String?  @db.Text
  eligibilityCriteria Json?             // { criteria: [{ name, required, met, notes }] }

  // Documents
  documents     Json?    @default("[]") // [{ name, url, type, uploadedAt }]

  // Assignment
  assignedToId  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bids          Bid[]
  emdRecords    EMDRecord[]
  boqItems      BOQItem[]

  @@unique([tenantId, referenceNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenders")
}

enum TenderSource {
  MANUAL
  GEM              // Government e-Marketplace
  CPPP             // Central Public Procurement Portal
  STATE_PORTAL
  PRIVATE
  REFERRAL
}

enum TenderStatus {
  IDENTIFIED
  EVALUATING
  PRE_QUALIFIED
  NOT_QUALIFIED
  BID_PREPARING
  BID_SUBMITTED
  WON
  LOST
  CANCELLED
  EXPIRED
}

enum PreQualStatus {
  NOT_CHECKED
  CHECKING
  QUALIFIED
  NOT_QUALIFIED_PQ
  IMPROVEMENT_NEEDED
}

model Bid {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  bidNo         String
  bidAmount     Decimal  @db.Decimal(15, 2)
  status        BidStatus @default(DRAFT)
  submittedAt   DateTime?
  result        BidResult @default(PENDING)
  resultNotes   String?  @db.Text
  winningAmount Decimal? @db.Decimal(15, 2)  // If lost, what was the winning bid
  competitorName String?                      // Who won if we lost

  // Analysis
  lossReason    String?
  lessonsLearned String? @db.Text
  keywords      Json?    @default("[]")      // For future tender matching
  documents     Json?    @default("[]")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, bidNo])
  @@index([tenantId])
  @@index([tenantId, tenderId])
  @@map("bids")
}

enum BidStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUBMITTED
  WITHDRAWN
}

enum BidResult {
